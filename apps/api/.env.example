# cp .env.example .env，编辑 .env 改密钥和 host
# cp .env.example .env.test，编辑 .env.test 改数据库和存储为本地测试地址
# .env 和 .env.test 都不提交（gitignore）

# ── 应用 ──
KB_APP_NAME=KnowledgeBase
KB_ENV=dev
KB_DEBUG=true

# ── 数据库 ──
# 裸机: localhost | Docker: db
KB_DATABASE__URL=postgresql://postgres:postgres@localhost:5432/knowledgebase
KB_DATABASE__PG_VECTOR_EXTENSION=vector

# ── 对象存储 ──
# 裸机: localhost | Docker: minio
KB_OBJECT_STORAGE__ENDPOINT=http://localhost:9000
# Docker 内部后端用 minio:9000，浏览器需要 localhost:9000
# KB_OBJECT_STORAGE__PUBLIC_ENDPOINT=http://localhost:9000
KB_OBJECT_STORAGE__ACCESS_KEY=minioadmin
KB_OBJECT_STORAGE__SECRET_KEY=minioadmin
KB_OBJECT_STORAGE__BUCKET=kb-source
KB_OBJECT_STORAGE__REGION=us-east-1
KB_OBJECT_STORAGE__PRESIGN_EXPIRE_SECONDS=900
KB_OBJECT_STORAGE__MAX_UPLOAD_SIZE_BYTES=20971520

# ── LLM (Chat) ──
# OpenAI-compatible API; switch KB_LLM__PROVIDER=anthropic for Claude
KB_LLM__PROVIDER=openai
KB_LLM__API_KEY=sk-your-api-key                 # ← API key
KB_LLM__BASE_URL=
KB_LLM__CHAT_MODEL=deepseek-v4-flash

# ── Embedding ──
KB_EMBEDDING__API_KEY=sk-your-api-key           # ← API key
KB_EMBEDDING__BASE_URL=
KB_EMBEDDING__MODEL=text-embedding-v4
KB_EMBEDDING__DIMENSION=1024
KB_EMBEDDING__BATCH_SIZE=100

# ── JWT ──
KB_JWT__SECRET=change-me-to-a-random-string     # ← 改成随机字符串
KB_JWT__ALGORITHM=HS256
KB_JWT__EXPIRY_MINUTES=1440

# ── CORS ──
KB_CORS_ORIGINS=["http://localhost:3000"]

# ── v0.x 自动建表 ──
KB_AUTO_CREATE_TABLES=true

# ── Telemetry（OpenTelemetry + Langfuse）──
KB_TELEMETRY__ENABLED=true
KB_TELEMETRY__ENVIRONMENT=development
KB_TELEMETRY__LANGFUSE_SECRET_KEY=sk-lf-...
KB_TELEMETRY__LANGFUSE_PUBLIC_KEY=pk-lf-...
KB_TELEMETRY__LANGFUSE_BASE_URL=https://cloud.langfuse.com

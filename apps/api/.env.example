# cp .env.example .env，编辑 .env 改密钥和 host
# cp .env.example .env.test，编辑 .env.test 改数据库和存储为本地测试地址
# .env 和 .env.test 都不提交（gitignore）

# ── 应用 ──
KS_APP_NAME=Knowledge Studio
KS_ENV=dev
KS_DEBUG=true

# ── 数据库 ──
# 裸机: localhost | Docker: db
KS_DATABASE__URL=postgresql://postgres:postgres@localhost:5432/knowledge_studio
KS_DATABASE__PG_VECTOR_EXTENSION=vector

# ── 对象存储 ──
# 裸机: localhost | Docker: minio
KS_OBJECT_STORAGE__ENDPOINT=http://localhost:9000
# Docker 内部后端用 minio:9000，浏览器需要 localhost:9000
# KS_OBJECT_STORAGE__PUBLIC_ENDPOINT=http://localhost:9000
KS_OBJECT_STORAGE__ACCESS_KEY=minioadmin
KS_OBJECT_STORAGE__SECRET_KEY=minioadmin
KS_OBJECT_STORAGE__BUCKET=ks-source
KS_OBJECT_STORAGE__REGION=us-east-1
KS_OBJECT_STORAGE__PRESIGN_EXPIRE_SECONDS=900
KS_OBJECT_STORAGE__MAX_UPLOAD_SIZE_BYTES=20971520

# ── LLM (Chat) ──
# OpenAI-compatible API; switch KS_LLM__PROVIDER=anthropic for Claude
KS_LLM__PROVIDER=openai
KS_LLM__API_KEY=sk-your-api-key                 # ← API key
KS_LLM__BASE_URL=
KS_LLM__CHAT_MODEL=deepseek-v4-flash

# ── Embedding ──
KS_EMBEDDING__API_KEY=sk-your-api-key           # ← API key
KS_EMBEDDING__BASE_URL=
KS_EMBEDDING__MODEL=text-embedding-v4
KS_EMBEDDING__DIMENSION=1024
KS_EMBEDDING__BATCH_SIZE=100

# ── JWT ──
KS_JWT__SECRET=change-me-to-a-random-string     # ← 改成随机字符串
KS_JWT__ALGORITHM=HS256
KS_JWT__EXPIRY_MINUTES=1440

# ── CORS ──
KS_CORS_ORIGINS=["http://localhost:3000"]

# ── v0.x 自动基础设施初始化 ──
KS_AUTO_CREATE_TABLES=true
KS_AUTO_CREATE_BUCKET=true

# ── Telemetry（OpenTelemetry + Langfuse）──
KS_TELEMETRY__ENABLED=true
KS_TELEMETRY__ENVIRONMENT=development
KS_TELEMETRY__LANGFUSE_SECRET_KEY=sk-lf-...
KS_TELEMETRY__LANGFUSE_PUBLIC_KEY=pk-lf-...
KS_TELEMETRY__LANGFUSE_BASE_URL=https://cloud.langfuse.com

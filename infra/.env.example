# 复制此文件为 infra/.env 并按需修改
#   cp infra/.env.example infra/.env
#
# 所有变量已在 docker-compose.yml 中提供默认值

# ── PostgreSQL 容器 ──
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=knowledgebase
DB_PORT=5432

# ── MinIO 容器 ──
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET=kb-source
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── 服务端口 ──
API_PORT=8000
WEB_PORT=3000

# ── 前端（浏览器端 API 地址）──
API_PUBLIC_URL=http://localhost:8000
